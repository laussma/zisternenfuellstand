void handleUpdateDone() {
  if (!server.authenticate(OTA_WEB_USER, OTA_WEB_PASS)) return server.requestAuthentication();
  bool ok = !Update.hasError();
  String pg = htmlHeader("Firmware Update");
  pg += "<div class='card'>";
  if (ok) {
    pg += "<h2>Update erfolgreich!</h2><p>Das Ger&auml;t startet in 5 Sekunden neu.</p>";
  } else {
    pg += "<h2>Update fehlgeschlagen!</h2><p>Bitte erneut versuchen.</p>";
  }
  pg += "</div><script>setTimeout(()=>location.href='/',5000);</script>";
  pg += htmlFooter();
  server.sendHeader("Connection", "close");
  server.send(200, "text/html", pg);
  if (ok) { delay(1000); ESP.restart(); }
}

void handleUpdateUpload() {
  HTTPUpload &upload = server.upload();
  if (upload.status == UPLOAD_FILE_START) {
    Serial.printf("[OTA] Upload: %s\n", upload.filename.c_str());
    if (!Update.begin(UPDATE_SIZE_UNKNOWN)) Update.printError(Serial);
  } else if (upload.status == UPLOAD_FILE_WRITE) {
    if (Update.write(upload.buf, upload.currentSize) != upload.currentSize) Update.printError(Serial);
  } else if (upload.status == UPLOAD_FILE_END) {
    if (Update.end(true)) Serial.printf("[OTA] OK: %u bytes\n", upload.totalSize);
    else Update.printError(Serial);
  }
}

void setup(){
  Serial.begin(115200);
  delay(200);
  pinMode(PIN_TRIG, OUTPUT);
  pinMode(PIN_ECHO, INPUT);
  attachInterrupt(digitalPinToInterrupt(PIN_ECHO), echoISR, CHANGE);
  loadPersist();
  loadWifiCreds();
  startAP();
  apExpires = millis() + AP_GRACE_PERIOD;
  if(staEnabled) connectSTA();

  server.on("/", pageRoot);
  server.on("/config", pageConfig);
  server.on("/wifi", HTTP_POST, handleWifi);
  server.on("/sta", HTTP_POST, handleStaToggle);
  server.on("/set_leer", HTTP_POST, handleSetLeer);
  server.on("/set_voll", HTTP_POST, handleSetVoll);
  server.on("/set_manual", HTTP_POST, handleSetManual);
  server.on("/publish", HTTP_POST, handlePublish);
  server.on("/measure", pageMeasure);
  server.on("/debug", handleDebug);
  server.on("/analog", HTTP_POST, handleAnalogToggle);
  server.on("/autoupdate", HTTP_POST, handleAutoUpdateToggle);
  server.on("/doku", handleDoku);
  server.on("/api/status", handleStatusAPI);
  server.on("/update", pageUpdate);
  server.on("/do_update", HTTP_POST, handleUpdateDone, handleUpdateUpload);
  server.onNotFound(notFound);
  server.begin();
  Serial.println("HTTP Server gestartet.");

  ArduinoOTA.setHostname(MDNS_HOST);
  ArduinoOTA.setPassword(OTA_ARDUINO_PASS);
  ArduinoOTA.onStart([]() { Serial.println("[OTA] Start"); });
  ArduinoOTA.onEnd([]()   { Serial.println("\n[OTA] Ende – Neustart..."); });
  ArduinoOTA.onProgress([](unsigned int progress, unsigned int total) {
    Serial.printf("[OTA] %u%%\r", progress * 100 / total);
  });
  ArduinoOTA.onError([](ota_error_t e) { Serial.printf("[OTA] Fehler[%u]\n", e); });
  ArduinoOTA.begin();
  Serial.println("[OTA] ArduinoOTA bereit.");
}

void loop(){
  server.handleClient();
  ArduinoOTA.handle();
  unsigned long now = millis();
  // Messung
  if(now - lastMeasure >= MEASURE_INTERVAL){
    lastMeasure = now;
    float d = measureDistance();
    // Plausibilitaet: Werte ausserhalb des kalibrierten Bereichs oder physikalisch
    // unmoegliche Spruenge verwerfen, bevor sie in die EMA einfliessen.
    bool plausible = !isnan(d);
    if (plausible && !isnan(d_leer) && !isnan(d_voll)) {
      float hiB = max(d_leer, d_voll) + 10.0f; // etwas Toleranz ueber "leer"
      float loB = min(d_leer, d_voll) - 10.0f; // und unter "voll"
      if (d > hiB || d < loB) plausible = false;
    }
    if (plausible && !isnan(lastDist) && fabsf(d - lastDist) > MAX_JUMP_CM)
      plausible = false; // Zisternenpegel aendert sich nicht meterweise in 2s
    if (plausible) {
      // EMA α=0.2: glättet Schwankungen, Zisternenpegel ändert sich langsam
      lastDist = isnan(lastDist) ? d : (0.2f * d + 0.8f * lastDist);
      lastPerc = computePercent(lastDist);
      volume   = calculateVolume(lastDist);
      lastGoodMeasure = now;
    } else if (lastGoodMeasure && (now - lastGoodMeasure > MEASURE_STALE_MS)) {
      // Sensor liefert zu lange nichts Brauchbares -> Anzeige nicht einfrieren
      lastDist = NAN; lastPerc = NAN; volume = NAN;
    }
    Serial.println("---------------------");
    Serial.print("Distance: ");
    Serial.println(d);
    Serial.print("Percent: ");
    Serial.println(lastPerc);
    Serial.print("Volumen: ");
    Serial.print(volume);
    Serial.println(" Liter");

    Serial.println("--- WiFi-Status ---");
    
    // STA-Status
    Serial.print("STA: ");
    switch(WiFi.status()) {
      case WL_CONNECTED: Serial.println("Verbunden (IP: " + WiFi.localIP().toString() + ")"); break;
      case WL_DISCONNECTED: Serial.println("Nicht verbunden"); break;
      case WL_NO_SSID_AVAIL: Serial.println("SSID nicht verfügbar"); break;
      case WL_CONNECT_FAILED: Serial.println("Verbindung fehlgeschlagen"); break;
      default: Serial.println("Unbekannter Status (" + String(WiFi.status()) + ")"); break;
    }
    
    // AP-Status
    Serial.print("AP: ");
    if(WiFi.getMode() == WIFI_AP_STA || WiFi.getMode() == WIFI_AP) {
      Serial.print("Aktiv (IP: " + WiFi.softAPIP().toString() + ", Clients: " + String(WiFi.softAPgetStationNum()) + ")");
    } else {
      Serial.print("Inaktiv");
    }
    Serial.println();    
  }
  // mDNS starten sobald STA-Verbindung steht (einmalig)
  if (WiFi.status() == WL_CONNECTED && !mdnsStarted) {
    Serial.println("[STA] Verbunden. IP: " + WiFi.localIP().toString());
    if (MDNS.begin(MDNS_HOST)) {
      MDNS.addService("http", "tcp", 80);
      Serial.println("[mDNS] http://" + String(MDNS_HOST) + ".local");
    } else {
      Serial.println("[mDNS] Start fehlgeschlagen");
    }
    mdnsStarted = true;
  }
  if (WiFi.status() != WL_CONNECTED && mdnsStarted) {
    mdnsStarted = false; // zurücksetzen damit mDNS nach Re-Connect neu startet
  }

  // STA-Retry alle 60 Sekunden falls nicht verbunden
  if (now - lastSTAcheck >= STA_RETRY_INTERVAL) {
    lastSTAcheck = now;
    if (staEnabled && WiFi.status() != WL_CONNECTED) {
      Serial.println("[STA] Nicht verbunden – neuer Versuch.");
      connectSTA();
    }
  }
  // AP in Grace Period sicherstellen
  if(now < apExpires){
    if(WiFi.getMode() != WIFI_AP_STA) WiFi.mode(WIFI_AP_STA);
    if(WiFi.softAPIP().toString() == "0.0.0.0"){
      WiFi.softAP(AP_SSID, AP_PASS);
      Serial.println("[AP] (Grace) sichergestellt.");
    }
  } else {
    if(WiFi.status() == WL_CONNECTED){
      if(WiFi.softAPgetStationNum() > 0 || WiFi.getMode() == WIFI_AP_STA){
        WiFi.softAPdisconnect(true);
        WiFi.mode(WIFI_STA);
        Serial.println("[AP] abgeschaltet nach erfolgreichem STA-Connect.");
      }
    } else {
      if(WiFi.getMode() != WIFI_AP_STA) WiFi.mode(WIFI_AP_STA);
      if(WiFi.softAPIP().toString() == "0.0.0.0"){
        WiFi.softAP(AP_SSID, AP_PASS);
        Serial.println("[AP] (Fallback) reaktiviert.");
      }
    }
  }

  // Automatische Update-Prüfung
  if (autoUpdateEnabled && WiFi.status() == WL_CONNECTED && now - lastOTACheck >= OTA_CHECK_INTERVAL) {
    lastOTACheck = now;
    checkAndApplyOTA();
  }

  // analoger Ausgang wenn aktiviert
  if(analogOutputEnabled && !isnan(lastPerc)){
    uint8_t dacVal = (uint8_t)round((lastPerc/100.0f)*255.0f);
    dacWrite(DAC_PIN, dacVal);
  } else {
    dacWrite(DAC_PIN, 0);
  }
}