}

void pageConfig() {
  // WiFi-Status für Anzeige auswerten
  wl_status_t ws = (wl_status_t)WiFi.status();
  String wifiStatusHtml;
  bool connecting = false;
  switch (ws) {
    case WL_CONNECTED:
      wifiStatusHtml = "<span style='color:green'>&#10003; Verbunden &ndash; IP: <b>"
                       + WiFi.localIP().toString() + "</b></span>";
      break;
    case WL_NO_SSID_AVAIL:
      wifiStatusHtml = "<span style='color:red'>&#10007; SSID nicht gefunden</span>";
      break;
    case WL_CONNECT_FAILED:
      wifiStatusHtml = "<span style='color:red'>&#10007; Verbindung fehlgeschlagen (Passwort?)</span>";
      break;
    default:
      if (staEnabled && sta_ssid.length()) {
        wifiStatusHtml = "<span style='color:orange'>&#9679; Verbinde mit &laquo;"
                         + htmlEncode(sta_ssid) + "&raquo;&hellip;</span>";
        connecting = true;
      } else {
        wifiStatusHtml = "<span style='color:gray'>Nicht konfiguriert</span>";
      }
  }

  String pg = htmlHeader("Konfiguration");
  if (connecting) pg += "<meta http-equiv='refresh' content='4'>";
  // WLAN
  pg += "<div class='card'><h2>Heim-WLAN</h2>";
  pg += "Status: " + wifiStatusHtml + "<br><br>";
  pg += "<form method='POST' action='/wifi'>";
  pg += "SSID:<input name='ssid' value='" + htmlEncode(sta_ssid) + "'/><br>";
  pg += "Passwort:<input type='password' name='pass' value='" + sta_pass + "'/><br>";
  pg += "<button type='submit'>Speichern &amp; Verbinden</button></form>";
  pg += "Client-Modus: <b>" + String(staEnabled?"AN":"AUS") + "</b> ";
  pg += "<form method='POST' action='/sta' style='display:inline'><button style='width:auto'>"
        + String(staEnabled?"Deaktivieren":"Aktivieren") + "</button></form></div>";
  // Kalibrierung
  pg += "<div class='card'><h2>Kalibrierung</h2>";
  if (server.arg("err") == "leer" || server.arg("err") == "voll")
    pg += "<p style='color:red'>&#9888; Messung fehlgeschlagen (kein Echo oder Blindzone) – "
          "der gespeicherte Wert wurde NICHT ge&auml;ndert. Bei sehr kurzer Distanz bitte manuell eingeben.</p>";
  pg += "Leer: <b>" + (isnan(d_leer) ? String("--") : String(d_leer, 1)) + " cm</b><br>";
  pg += "Voll: <b>" + (isnan(d_voll) ? String("--") : String(d_voll, 1)) + " cm</b><br>";
  pg += "Durchmesser: <b>" + (isnan(diameter) ? String("--") : String(diameter, 1)) + " cm</b><br>";
  if (!isnan(d_voll) && d_voll < SENSOR_MIN_CM)
    pg += "<p style='color:red'>&#9888; Voll-Wert liegt in der Blindzone des Sensors (&lt;"
          + String(SENSOR_MIN_CM, 0) + " cm) – Messung unzuverl&auml;ssig!</p>";
  pg += "<form method='POST' action='/set_leer'><button>Setze LEER = aktuelle Distanz</button></form>";
  pg += "<form method='POST' action='/set_voll'><button>Setze VOLL = aktuelle Distanz</button></form>";
  pg += "<form method='POST' action='/set_manual'>";
  pg += "Manuell setzen:<br>Leer (cm): <input name='leer_val' type='number' step='0.1' value='" + (isnan(d_leer) ? String("") : String(d_leer, 1)) + "'/><br>";
  pg += "Voll (cm): <input name='voll_val' type='number' step='0.1' value='" + (isnan(d_voll) ? String("") : String(d_voll, 1)) + "'/><br>";
  pg += "Durchmesser (cm): <input name='diameter_val' type='number' step='0.1' value='" + (isnan(diameter) ? String("") : String(diameter, 1)) + "'/><br>";
  pg += "<button type='submit'>Speichern</button></form></div>";
  pg += "<div class='card'><h2>Publishing</h2>";
  pg += "Status: <b>" + String(publishEnabled?"AN":"AUS") + "</b><br>";
  pg += "<form method='POST' action='/publish'><button>" + String(publishEnabled?"Deaktivieren":"Aktivieren") + " Publishing</button></form></div>";
  pg += "<div class='card'><h2>Analogausgang</h2>";
  pg += "Aktiv: <b>" + String(analogOutputEnabled?"JA":"NEIN") + "</b><br>";
  pg += "<form method='POST' action='/analog'><button>" + String(analogOutputEnabled?"Deaktivieren":"Aktivieren") + " DAC-Ausgabe</button></form>";
  pg += "<small>Gibt den Füllstand 0–100% als 0–3,3V über DAC1 (GPIO25) aus.</small>";
  pg += "</div>";
  pg += "<div class='card'><h2>Firmware</h2>";
  pg += "Version: <b>" FW_VERSION "</b><br>";
  pg += "Auto-Update: <b>" + String(autoUpdateEnabled ? "AN" : "AUS") + "</b>";
  pg += "<small> (pr&uuml;ft st&uuml;ndlich auf neue Version)</small><br>";
  pg += "<form method='POST' action='/autoupdate'><button>" + String(autoUpdateEnabled ? "Deaktivieren" : "Aktivieren") + " Auto-Update</button></form>";
  pg += "<a href='/update'><button>Jetzt manuell aktualisieren</button></a>";
  pg += "</div>";
  pg += "<p><a href='/'>← Zurück</a></p>";
  pg += htmlFooter();
  server.send(200, "text/html", pg);
}

void handleWifi(){
  if(server.hasArg("ssid") && server.hasArg("pass")){
    sta_ssid = server.arg("ssid");
    sta_pass = server.arg("pass");
    saveWifiCreds();
    connectSTA();
  }
  server.sendHeader("Location", "/config");
  server.send(303);
}

void handleStaToggle(){
  staEnabled = !staEnabled;
  saveWifiCreds();
  if(staEnabled){
    connectSTA();
  } else {
    WiFi.disconnect(false, false);
    mdnsStarted = false;
  }
  server.sendHeader("Location", "/config");
  server.send(303);
}

void handleSetLeer(){
  float d = measureDistance();
  if(isnan(d)){ server.sendHeader("Location", "/config?err=leer"); server.send(303); return; }
  d_leer = d;
  savePersist();
  server.sendHeader("Location", "/config");
  server.send(303);
}

void handleSetVoll(){
  float d = measureDistance();
  if(isnan(d)){ server.sendHeader("Location", "/config?err=voll"); server.send(303); return; }
  d_voll = d;
  savePersist();
  server.sendHeader("Location", "/config");
  server.send(303);
}

void handleSetManual(){
  if(server.hasArg("leer_val") && server.hasArg("voll_val") && server.hasArg("diameter_val"))
  {
    float leer = server.arg("leer_val").toFloat();
    float voll = server.arg("voll_val").toFloat();
    float d = server.arg("diameter_val").toFloat();
    if(!isnan(leer)) d_leer = leer;
    if(!isnan(voll)) d_voll = voll;
    if(!isnan(d)) diameter = d;
  }
  else {
    if(server.hasArg("leer_val")){
    float v = server.arg("leer_val").toFloat();
    if(!isnan(v)) d_leer = v;
    }
    if(server.hasArg("voll_val")){
      float v = server.arg("voll_val").toFloat();
      if(!isnan(v)) d_voll = v;
    }
    if(server.hasArg("diameter_val")){
      float v = server.arg("diameter_val").toFloat();
      if(!isnan(v)) diameter = v;
    }
  }
  if(d_voll > d_leer){ float t = d_leer; d_leer = d_voll; d_voll = t; }
  savePersist();
  server.sendHeader("Location", "/config");
  server.send(303);
}

void handlePublish(){
  publishEnabled = !publishEnabled;
  savePersist();
  server.sendHeader("Location", "/config");
  server.send(303);
}

void handleDebug(){
  String j = "{\"samples_us\":[";
  for (uint8_t i = 0; i < SAMPLES; ++i) {
    j += String(g_lastSamples[i]);
    if (i < SAMPLES-1) j += ",";
  }
  j += "],\"computed_cm\":" + (isnan(lastDist) ? String("null") : String(lastDist,2));
  j += ",\"sensor_min_cm\":" + String(SENSOR_MIN_CM,0);
  j += ",\"timeout_us\":" + String(ULTRASONIC_TIMEOUT);
  // ISR-Diagnose: keine Flanken = Verkabelung/Versorgung; nur rejected = Blindzone/Resonanz
  j += ",\"isr_rising\":" + String(g_isrRising);
  j += ",\"isr_falling\":" + String(g_isrFalling);
  j += ",\"isr_rejected_short\":" + String(g_isrRejected);
  j += ",\"last_rejected_us\":" + String(g_lastRejectedUs);
  j += ",\"valid_count\":" + String(g_lastValidCount) + ",\"samples_total\":" + String(SAMPLES);
  j += ",\"cluster_size\":" + String(g_lastClusterLen);
  j += ",\"echo_pin_level\":" + String(digitalRead(PIN_ECHO));
  j += ",\"last_good_age_ms\":" + String(lastGoodMeasure ? (millis() - lastGoodMeasure) : 0);
  j += ",\"fw\":\"" FW_VERSION "\"";
  j += "}";
  server.send(200, "application/json", j);
}

void pageMeasure(){
  float d = measureDistance();
  float p = computePercent(d);
  float vol = calculateVolume(d);
  String pg = htmlHeader("Messung");
  pg += "<div class='card'><h2>Einzelmessung</h2>";
  pg += "Distanz: <b>" + (isnan(d)? String("--") : String(d,1) + " cm") + "</b><br>";
  pg += "Füllstand: <b>" + (isnan(p)? String("--") : String(p,1)) + " %</b><br>";
  pg += "Volumen: <b>" + (isnan(vol)? String("--") : String(vol,1)) + " Liter</b></div>";
  pg += "<p><a href='/'>";
  pg += "<button>Zurück</button></a></p>";
  pg += htmlFooter();
  server.send(200, "text/html", pg);
}

void handleStatusAPI(){
  if(!publishEnabled){
    server.send(403, "application/json", "{\"error\":\"publishing disabled\"}");
    return;
  }
  float d = lastDist;
  float p = lastPerc;
  String json = "{";
  json += "\"distance_cm\":" + (isnan(d)? String("null") : String(d,2)) + ",";
  json += "\"percent\":" + (isnan(p)? String("null") : String(p,2)) + ",";
  json += "\"analog_output\":" + String(analogOutputEnabled?"true":"false") + ",";
  json += "\"volumen\":" + (isnan(volume)? String("null") : String(volume,2)) + ",";
  // age_ms = Alter der letzten gueltigen Messung; valid=false signalisiert haengenden Sensor
  unsigned long age = lastGoodMeasure ? (millis() - lastGoodMeasure) : 0;
  bool valid = !isnan(d) && lastGoodMeasure && (age <= MEASURE_STALE_MS);
  json += "\"valid\":" + String(valid?"true":"false") + ",";
  json += "\"age_ms\":" + String(age) + ",";
  json += "\"timestamp_ms\":" + String(millis());
  json += "}";
  server.send(200, "application/json", json);
}

