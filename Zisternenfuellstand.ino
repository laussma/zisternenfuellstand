// ---------- Helfer -----------------------------
// distance in cm, return volume in Liter
float calculateVolume(float distance) {
    if(isnan(d_leer) || isnan(d_voll) || isnan(diameter) || isnan(distance)) return NAN;
    float pi = 3.141592;
    float hi = max(d_leer, d_voll);              // "leer" = groesste Distanz (Referenz)
    float lo = min(d_leer, d_voll);              // "voll" = kleinste Distanz
    float height = (hi - distance) / 10;         // Wassersaeule in dm
    if (height < 0) height = 0;                  // unter "leer": 0 statt negativ
    float maxH = (hi - lo) / 10;
    if (height > maxH) height = maxH;            // ueber "voll": auf max gedeckelt
    float diameter_l = diameter / 10;
    return ((diameter_l * diameter_l * pi) / 4) * height;
}

float medianOf(uint32_t *arr, uint8_t n) {
  for (uint8_t i = 0; i < n - 1; ++i) {
    uint8_t minIdx = i;
    for (uint8_t j = i + 1; j < n; ++j) if (arr[j] < arr[minIdx]) minIdx = j;
    if (minIdx != i) { uint32_t t = arr[i]; arr[i] = arr[minIdx]; arr[minIdx] = t; }
  }
  return (n & 1) ? arr[n/2] : 0.5f * (arr[n/2 - 1] + arr[n/2]);
}

float measureDistance() {
  uint32_t valid[SAMPLES];   // nur erfolgreich gemessene Echos
  uint8_t  validCount = 0;
  for (uint8_t i = 0; i < SAMPLES; ++i) {
    g_echoReady = false;
    g_echoStart = 0;
    digitalWrite(PIN_TRIG, LOW);  delayMicroseconds(2);
    digitalWrite(PIN_TRIG, HIGH); delayMicroseconds(10);
    digitalWrite(PIN_TRIG, LOW);
    // Tight-Loop: kein yield() damit WiFi-Tasks keine ISR-Flanke verdecken
    uint32_t deadline = micros() + ULTRASONIC_TIMEOUT;
    while (!g_echoReady && (int32_t)(micros() - deadline) < 0) { /* busy wait */ }
    g_lastSamples[i] = g_echoReady ? g_echoDur : ULTRASONIC_TIMEOUT; // Debug: roh inkl. Timeouts
    if (g_echoReady) valid[validCount++] = g_echoDur;                // nur echte Echos in den Pool
    delay(35); // WiFi bekommt Zeit zwischen den Samples
  }
  g_lastValidCount = validCount;
  // Qualitaets-Gate: weniger als die Haelfte gueltige Echos -> keine verlaessliche Messung.
  if (validCount < SAMPLES / 2) return NAN;
  medianOf(valid, validCount); // sortiert in-place (Rueckgabe hier egal)

  // Cluster-Schaetzer statt globalem Median:
  // Echte Echos von einer Oberflaeche liegen eng beieinander (wenige cm),
  // Multipath-/Stoerechos streuen breit und liegen typisch NAEHER als das
  // Ziel. Ein globaler Median mischt beide Gipfel und "wandert" mit dem
  // Mischverhaeltnis (beobachtet: 241cm -> 122cm Drift).
  // Schritt 1: zusammenhaengende Gruppen finden (Nachbar-Gap <= max(5%, 10cm))
  uint8_t cStart[SAMPLES], cLenArr[SAMPLES], cCount = 0;
  uint8_t curStart = 0, curLen = 1;
  for (uint8_t i = 1; i < validCount; ++i) {
    uint32_t gap = valid[i] - valid[i-1];
    uint32_t thr = valid[i-1] / 20;              // 5% relativ ...
    if (thr < 580) thr = 580;                    // ... mindestens 10cm (580us)
    if (gap <= thr) {
      curLen++;
    } else {
      cStart[cCount] = curStart; cLenArr[cCount] = curLen; cCount++;
      curStart = i; curLen = 1;
    }
  }
  cStart[cCount] = curStart; cLenArr[cCount] = curLen; cCount++;

  uint8_t bestLen = 0;
  for (uint8_t c = 0; c < cCount; ++c) if (cLenArr[c] > bestLen) bestLen = cLenArr[c];
  g_lastClusterLen = bestLen;
  // Kein dominantes Cluster (alles verstreut) -> keine vertrauenswuerdige Messung
  if (bestLen < 4) return NAN;

  // Schritt 2 (an realen Messreihen verifiziert): unter allen Clustern mit
  // Laenge >= 3/4 des groessten gewinnt das FERNSTE. Grund: Stoerbaender
  // haben oft 1-2 Samples mehr als das echte Ziel, liegen aber naeher und
  // breiter. Reines "groesstes Cluster" lieferte auf realen Daten 165cm
  // statt 241cm; diese Regel trifft beide realen Sets korrekt.
  uint8_t need = bestLen - bestLen / 4;
  if (need < 4) need = 4;
  uint8_t sel = 0;
  for (uint8_t c = 0; c < cCount; ++c) if (cLenArr[c] >= need) sel = c; // letztes qualifiziertes = fernstes
  g_lastClusterLen = cLenArr[sel];

  float us = medianOf(valid + cStart[sel], cLenArr[sel]); // Median des Gewinner-Clusters
  float cm = us / 58.0f;
  if (cm < SENSOR_MIN_CM) return NAN;
  return cm;
}

float computePercent(float d) {
  if (isnan(d) || isnan(d_leer) || isnan(d_voll)) return NAN;
  float hi = max(d_leer, d_voll);
  float lo = min(d_leer, d_voll);
  if (hi == lo) return NAN;
  float p = 100.0f * (hi - d) / (hi - lo);
  if (p < 0) p = 0;
  if (p > 100) p = 100;
  return p;
}

// ---------- Persistenz --------------------------
void loadPersist() {
  prefs.begin("fuell", true);
  d_leer = prefs.getFloat("leer", NAN);
  d_voll = prefs.getFloat("voll", NAN);
  diameter = prefs.getFloat("diameter", NAN);
  publishEnabled = prefs.getBool("pub", false);
  analogOutputEnabled = prefs.getBool("analog", false);
  autoUpdateEnabled = prefs.getBool("autoupd", false);
  prefs.end();
}
void savePersist() {
  // Invariante d_leer >= d_voll in JEDEM Kalibrierpfad sicherstellen (auch Capture-Buttons),
  // sonst rechnet calculateVolume mit vertauschter Referenz.
  if(!isnan(d_leer) && !isnan(d_voll) && d_voll > d_leer){
    float t = d_leer; d_leer = d_voll; d_voll = t;
  }
  prefs.begin("fuell", false);
  prefs.putFloat("leer", d_leer);
  prefs.putFloat("voll", d_voll);
  prefs.putFloat("diameter", diameter);
  prefs.putBool("pub", publishEnabled);
  prefs.putBool("analog", analogOutputEnabled);
  prefs.putBool("autoupd", autoUpdateEnabled);
  prefs.end();
}
void loadWifiCreds() {
  prefs.begin("net", true);
  sta_ssid = prefs.getString("ssid", "");
  sta_pass = prefs.getString("pass", "");
  staEnabled = prefs.getBool("en", true);
  prefs.end();
}
void saveWifiCreds() {
  prefs.begin("net", false);
  prefs.putString("ssid", sta_ssid);
  prefs.putString("pass", sta_pass);
  prefs.putBool("en", staEnabled);
  prefs.end();
}

// ---------- WLAN -------------------------------
void startAP() {
  WiFi.mode(WIFI_AP_STA);
  WiFi.softAPConfig(IPAddress(192,168,4,1), IPAddress(192,168,4,1), IPAddress(255,255,255,0)); // Feste IP
  WiFi.softAP(AP_SSID, AP_PASS, 6, 0, 4); // Kanal 6, nicht versteckt, max 4 Clients
  delay(100); // Warte auf Stabilisierung
  Serial.println("[AP] gestartet: " + String(AP_SSID) + " IP: " + WiFi.softAPIP().toString());
}

void connectSTA() {
  if (!staEnabled || !sta_ssid.length()) return;
  WiFi.mode(WIFI_AP_STA);
  WiFi.disconnect(false, false); // nur STA trennen, AP bleibt
  delay(50);
  Serial.println("[STA] Starte Verbindung zu '" + sta_ssid + "' …");
  WiFi.begin(sta_ssid.c_str(), sta_pass.c_str());
  // nicht blockierend – loop() erkennt WL_CONNECTED und richtet mDNS ein
}

// ---------- HTML -------------------------------
String htmlEncode(const String &s) {
  String r = s;
  r.replace("&", "&amp;");
  r.replace("<", "&lt;");
  r.replace(">", "&gt;");
  r.replace("\"", "&quot;");
  r.replace("'", "&#39;");
  return r;
}

String htmlHeader(const String &title) {
  String h = "<!DOCTYPE html><html><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'>";
  h += "<title>" + title + "</title><style>body{font-family:Arial,Helvetica,sans-serif;max-width:640px;margin:1rem;}button,input{padding:8px;margin:4px;width:100%;box-sizing:border-box;}div.card{border:1px solid #ccc;padding:14px;margin:16px 0;border-radius:8px;}h1{font-size:1.4rem;margin:0 0 1rem;}footer{font-size:.75rem;color:#666;margin-top:1.5rem;}small{display:block;margin-top:6px;color:#555;}</style></head><body>";
  if (logoBase64.length() > 0) {
    h += "<img src='data:" + logoMimeType + ";base64," + logoBase64 + "' alt='Logo' style='max-width:200px; display:block; margin:0 auto 1rem;'>";
  }
  h += "<h1>Zisternenfüllstand</h1>";
  return h;
}
String htmlFooter() {
  String f = "<footer>STA: " + (WiFi.status() == WL_CONNECTED ? WiFi.localIP().toString() : String("--"));
  f += " | AP: " + WiFi.softAPIP().toString();
  f += " | v" FW_VERSION;
  f += " | <a href='/update'>Update</a>";
  f += " | <a href='/doku' target='_blank'>Doku</a>";
  f += "</footer></body></html>";
  return f;
}

