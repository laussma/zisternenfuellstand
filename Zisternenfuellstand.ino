void checkAndApplyOTA() {
  if (WiFi.status() != WL_CONNECTED) return;
  Serial.println("[AutoOTA] Prüfe auf neue Firmware...");
  WiFiClientSecure client;
  client.setInsecure(); // kein Zertifikats-Check – akzeptabler Trade-off für lokales IoT-Gerät
  HTTPClient http;
  http.begin(client, OTA_VERSION_URL);
  http.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);
  int code = http.GET();
  if (code == 200) {
    String remote = http.getString();
    remote.trim();
    Serial.println("[AutoOTA] Remote: " + remote + " | Lokal: " FW_VERSION);
    if (remote.length() > 0 && remote != FW_VERSION) {
      Serial.println("[AutoOTA] Neue Version verfügbar – starte Update...");
      http.end();
      WiFiClientSecure uc;
      uc.setInsecure();
      httpUpdate.rebootOnUpdate(true);
      t_httpUpdate_return ret = httpUpdate.update(uc, OTA_FIRMWARE_URL);
      if (ret == HTTP_UPDATE_FAILED) {
        Serial.println("[AutoOTA] Fehler: " + httpUpdate.getLastErrorString());
      }
      return;
    } else {
      Serial.println("[AutoOTA] Firmware ist aktuell.");
    }
  } else {
    Serial.println("[AutoOTA] Versionsprüfung fehlgeschlagen: HTTP " + String(code));
  }
  http.end();
}

